  <activity class="@memory.MemoryGame" name="BUSCA PARELLES" code="">
   <description>
    <p>Resoldre el tauler emparellant totes les fitxes de números romans amb les de números decimals mitjançant mecàniques de memòria clàssica.</p>
   </description>
