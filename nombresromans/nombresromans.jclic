     <style borderStroke="0.7" markerStroke="5.0">
      <font family="Arial" size="18" />
      <color background="0xEDF7F7" />
     </style>
     <p>Troba les parelles.</p>
    </cell>
    <cell type="final">
     <style>
      <color background="0xEDEDF7" />
     </style>
     <p>Felicitats!</p>
    </cell>
   </messages>
