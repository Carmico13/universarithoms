  <activity class="@text.WrittenAnswer" name="QUIN NÚMERO ÉS?" code="">
   <description>
    <p>Escriure el número romà que equival al número decimal que apareix e en un requadre de text.&#xD;</p>
    <p>&#xD;</p>
